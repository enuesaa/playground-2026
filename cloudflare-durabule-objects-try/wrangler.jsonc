{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-durabule-objects-try",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"durable_objects": {
		"bindings": [
			{
				"name": "BOARD_ROOM",
				"class_name": "BoardRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BoardRoom"]
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}