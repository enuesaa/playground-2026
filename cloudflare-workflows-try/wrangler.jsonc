{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-workflows-try",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"workflows": [
		{
			"name": "workflow-cloudflare-workflows-try",
			"binding": "MY_WORKFLOW",
			"class_name": "MyWorkflow"
		}
	],
	"upload_source_maps": true
}
