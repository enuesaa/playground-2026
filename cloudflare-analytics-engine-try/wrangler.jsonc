{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-analytics-engine-try",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS_ENGINE",
			"dataset": "xxx",
		}
	]
}
