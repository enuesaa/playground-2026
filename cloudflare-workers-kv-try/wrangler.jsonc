{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-workers-kv-try",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "MY_KV",
			"id": "xxx",
			"remote": true
		}
	]
}
