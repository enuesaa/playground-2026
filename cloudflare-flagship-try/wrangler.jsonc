{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-flagship-try",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"flagship": [
		{
			"binding": "FLAGS",
			"app_id": "<APP_ID>"
		}
	]
}
