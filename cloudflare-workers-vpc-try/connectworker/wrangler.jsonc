{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "connectworker",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vpc_services": [
		{
			"binding": "VPC_SERVICE",
			"service_id": "xxx"
		}
	]
}
